    },
    "version": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "model": {
      "const": "PAY_AUTHORIZE_PROVE"
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pay": {
      "type": "object"
    },
    "authorize": {
      "type": "object"
    },
    "prove": {
      "type": "object"
    },
    "merchantCompatibility": {
      "type": "object"
    },
    "micropayments": {
      "type": "object"
    },
    "securityAndSafety": {
      "type": "object"
    },
    "machineDecisionFlow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "endpoints": {
      "type": "object"
    },
    "status": {
      "type": "object"
    },
    "disclaimer": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
