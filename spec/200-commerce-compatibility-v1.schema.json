{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juhastar-dev.github.io/200-protocol/spec/200-commerce-compatibility-v1.schema.json",
  "title": "200 Protocol Commerce Compatibility v1",
  "type": "object",
  "required": [
    "schema",
    "protocol",
    "version",
    "purpose",
    "model",
    "principles",
    "pay",
    "authorize",
    "prove",
    "merchantCompatibility",
    "securityAndSafety",
    "machineDecisionFlow",
    "status"
  ],
  "properties": {
